<?xml version="1.0" encoding="utf-8"?>
<!-- HTTPS only, and only system-trusted CAs: user-installed certificates
     (used for TLS interception) are not trusted. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
