# ── Runtime ─────────────────────────────────────────────────────────────────
# development | production. In production the server refuses to start unless
# the Stripe/PayPal credentials below are present.
APP_ENV=development
PORT=8080

# Set to true ONLY when running behind a trusted reverse proxy (nginx/CDN) so
# the rate limiter sees the real client IP from X-Forwarded-For.
TRUST_PROXY=false

# ── Shared app secret (recommended) ─────────────────────────────────────────
# When set, every payment request must carry an `X-Api-Key: <value>` header.
# Leave empty to disable the gate (e.g. local dev). Generate with:
#   openssl rand -hex 32
APP_API_KEY=

# ── Stripe ──────────────────────────────────────────────────────────────────
# Secret key (server-side ONLY — never ship this to the app). Test keys: sk_test_…
STRIPE_SECRET_KEY=
# Must match the API version used by the Stripe Android SDK in the app,
# otherwise the ephemeral key is rejected by PaymentSheet.
STRIPE_API_VERSION=2024-12-18.acacia
# From the Stripe Dashboard webhook endpoint (used to verify signatures).
STRIPE_WEBHOOK_SECRET=

# ── PayPal ──────────────────────────────────────────────────────────────────
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# sandbox | live
PAYPAL_ENV=sandbox
# Server-side webhook id (verifies PayPal webhook signatures).
PAYPAL_WEBHOOK_ID=

# ── Amount limits (server-side, cents for Stripe / dollars for PayPal) ──────
MIN_AMOUNT_CENTS=100
MAX_AMOUNT_CENTS=1000000
MIN_AMOUNT_DOLLARS=1
MAX_AMOUNT_DOLLARS=10000
